# REVIA — Environment Variables
# Copy this to .env.local and fill in your values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (never expose to the browser)
TMDB_API_KEY=your-tmdb-api-key-here

# Server-only. Bypasses row level security, so keep it out of the browser
# and out of git. Used for username sign-in and the admin e-mail column;
# required once supabase/security-hardening.sql has been run.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
